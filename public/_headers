# Для Cloudflare Pages (на GitHub Pages файл просто игнорируется).
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-store
/news.md
  Cache-Control: no-store
/info.md
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
